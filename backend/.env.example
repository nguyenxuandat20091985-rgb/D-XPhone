# Server
PORT=3001
NODE_ENV=production

# JWT
JWT_SECRET=change-this-to-a-very-long-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=2h

# Redis (required for production / multi-instance)
REDIS_URL=redis://localhost:6379

# CORS (comma-separated origins, * for development only)
CORS_ORIGINS=*

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Room settings
ROOM_TTL_SECONDS=3600
